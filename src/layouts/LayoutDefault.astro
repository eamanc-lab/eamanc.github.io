---
import { themeConfig } from '~/.config'
import TopNav from '~/components/TopNav.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LaTeX from '~/components/LaTeX.astro'
import Analytics from '~/components/Analytics.astro'
import ThemeScript from '~/components/ThemeScript.astro'
import SumiBackground from '~/components/SumiBackground.astro'
import SumiFilters from '~/components/SumiFilters.astro'
import '~/styles/global.css'

const lang = themeConfig.appearance.locale ?? 'en-us'
const dark = themeConfig.appearance.theme === 'dark'
---

<html lang={lang} data-motion="on" class:list={['animation-prepared', { dark }]}>
  <head>
    <slot name="seo"> <SiteSeo /> </slot>
    <LaTeX />
    <Analytics />
    <ThemeScript />
  </head>

  <body>
    <SumiBackground />
    <SumiFilters />

    <TopNav />

    <main class="page-stage transition-swup-main" id="swup-main">
      <slot />
    </main>

    <footer class="site-footer-v3">
      <span class="site-footer__copy">© {new Date().getFullYear()} Eaman · 雾散之前</span>
      <span class="mini-seal" aria-hidden="true">墨</span>
    </footer>

    <script>
      document.addEventListener('animationend', removeAnimation, false)
      function removeAnimation() {
        document.documentElement.classList.remove('animation-prepared')
        document.removeEventListener('animationend', removeAnimation, false)
      }
    </script>
    {/* Task 11 — sumi 交互 JS 入口
        - 默认 module 编译(无 is:inline),走 Astro/Vite ts import 链路,严格 TS 校验通过
        - astro:page-load 是 Astro 官方事件,@swup/astro 在每次软切换后自动派发(与首屏
          DOMContentLoaded 行为统一);initSumi() 内置 dataset 幂等标记,header/footer
          持久元素不重复绑事件,<main> 内新 DOM 自动重新初始化
        - 首屏立即调一次 initSumi():处理 hydration 后第一帧的 char-reveal/aria-current/
          pointer tracking;astro:page-load 自此后接管 */}
    <script>
      import { initSumi } from '~/scripts/sumi'
      document.addEventListener('astro:page-load', initSumi)
      initSumi()
    </script>
    <style>
      /* 页面过渡动画 - 由 global.css 的 gentle-rise 接管入场 */
      html.is-animating .transition-swup-main {
        opacity: 0;
        transform: translateY(8px);
      }
      html.is-leaving .transition-swup-main {
        opacity: 0;
        transform: translateY(-8px);
      }
      .transition-swup-main {
        transition-duration: 0.6s;
        transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
        transform: translateY(0);
        opacity: 1;
      }
    </style>
  </body>
</html>
