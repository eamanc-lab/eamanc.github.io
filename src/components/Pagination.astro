---
const { translate: t } = Astro.locals

interface Props {
  showLeft?: boolean
  leftTitle?: string
  leftUrl?: string

  showRight?: boolean
  rightTitle?: string
  rightUrl?: string

  showPageCount?: boolean
  currentPage?: number
  totalPage?: number
}

const {
  showLeft = true,
  showRight = true,
  leftTitle,
  rightTitle,
  leftUrl,
  rightUrl,
  showPageCount = true,
  currentPage,
  totalPage,
} = Astro.props
---

<footer class="pagination mt-5">
  {
    showPageCount && (
      <div class="pagination__count mb-2.5">
        <span class="pagination__count-num">{t('page_number', currentPage)}</span>
        <span class="pagination__count-sep"> / </span>
        <span class="pagination__count-num">{t('page_count', totalPage)}</span>
      </div>
    )
  }
  <div class="pagination__row flex items-center gap-2">
    {
      showLeft && (
        <a class="pagination__link pagination__prev not-underline-hover" title={leftTitle} href={leftUrl}>
          <span class="pagination__chevron inline-block vertical-mid i-mdi-chevron-double-left w-4 h-4" />
          {leftTitle}
        </a>
      )
    }
    {
      showRight && (
        <a class="pagination__link pagination__next not-underline-hover" title={rightTitle} href={rightUrl}>
          {rightTitle}
          <span class="pagination__chevron inline-block vertical-mid i-mdi-chevron-double-right w-4 h-4" />
        </a>
      )
    }
  </div>
</footer>
