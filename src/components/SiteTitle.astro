---
import { themeConfig } from '~/.config'

const { title, subtitle } = themeConfig.site
---

<!-- 方案 2 放大版：签名落款 + 大字 -->
<hgroup
  lg="items-end text-right"
  flex="~ col"
  class="cursor-pointer text-center duration-500 ease-in-out"
>
  <a
    class="not-underline-hover group inline-flex flex-col items-center"
    href="/"
  >
    <h1 class="text-7 font-header font-bold tracking-widest leading-tight"
      style="letter-spacing: 0.15em;"
    >{title}</h1>
    <div class="my-2" style="width: 28px; height: 1px; opacity: 0.25; background: var(--accent-color);"></div>
    <h3 class="text-4 font-ui font-light tracking-widest"
      style="letter-spacing: 0.25em; opacity: 0.4;"
    >{subtitle}</h3>
  </a>
</hgroup>
