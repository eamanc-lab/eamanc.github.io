---
import { getEntry, render } from 'astro:content'
import Hero from '~/components/Hero.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const entry = await getEntry('spec', 'about')
if (!entry) {
  throw new Error('No about entry found')
}
const { Content } = await render(entry)
---

<LayoutDefault>
  <Hero
    eyebrow={{ seal: '我', label: 'About · Eaman' }}
    title="关于"
    sub="一个 AI 应用探索的工程师 — Eaman · 业余跑者。"
    bgChar="人"
  />

  <article class="page-section page-section--about prose">
    <Content />
  </article>
</LayoutDefault>
