---
import Hero from '~/components/Hero.astro'
import SectionHead from '~/components/SectionHead.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { formatDate, getPosts, withBase } from '~/utils'

const posts = await getPosts(true)

const yearMap = getYearMap(posts)

interface ListItem {
  title: string
  href: string
  date: string
}

function getYearMap(posts: Post[]) {
  const result = new Map<number, ListItem[]>()
  for (const post of posts) {
    const year = (post.data.pubDate ?? new Date()).getFullYear()
    const ps = result.get(year) ?? []
    ps.push({
      title: post.data.title,
      href: withBase(`/posts/${post.id}/`),
      date: formatDate(post.data.pubDate, 'MM-DD'),
    })
    result.set(year, ps)
  }
  return Array.from(result.entries())
}
---

<LayoutDefault>
  <Hero
    compact
    eyebrow={{ seal: '尾', label: 'Archive · 二〇二六' }}
    title="归档"
    sub="按年时间索引,从近到远。"
    bgChar="尾"
  />

  {yearMap.map(([year, items]) => (
    <section class="page-section">
      <SectionHead
        eyebrow={{ cal: '岁', label: `${year}` }}
        title={`${year}`}
      />
      <ul class="post-list">
        {items.map(({ title, href, date }) => (
          <li class="post-list__item">
            <a class="post-list__title" href={href}>{title}</a>
            <time class="post-list__date">{date}</time>
          </li>
        ))}
      </ul>
    </section>
  ))}
</LayoutDefault>
