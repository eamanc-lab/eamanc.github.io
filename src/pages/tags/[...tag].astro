---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { formatDate, getPosts, withBase } from '~/utils'

export async function getStaticPaths() {
  const posts = await getPosts()
  const tagMap = new Map<string, Post[]>()

  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const list = tagMap.get(tag) ?? []
      list.push(post)
      tagMap.set(tag, list)
    }
  }

  return Array.from(tagMap).map(([tag, posts]) => ({
    params: { tag },
    props: { posts, tag },
  }))
}

const { posts, tag } = Astro.props

function getListItems(posts: Post[]) {
  return posts.map((post) => ({
    title: post.data.title,
    href: withBase(`/posts/${post.id}/`),
    date: formatDate(post.data.pubDate),
  }))
}
---

<LayoutDefault>
  <section class="archive-index">
    <h2 class="archive-index__title">
      <span class="archive-index__prefix" aria-hidden="true">#</span>{tag}
    </h2>
    <ul class="post-list">
      {
        getListItems(posts).map(({ title, href, date }) => (
          <li class="post-list__item">
            <a class="post-list__title" href={href}>{title}</a>
            <time class="post-list__date">{date}</time>
          </li>
        ))
      }
    </ul>
  </section>
</LayoutDefault>
