---
import { themeConfig } from '~/.config'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getCategories, getPathFromCategory, getPosts, withBase } from '~/utils/index'

const { translate: t } = Astro.locals
const categoryMap = await getCategories()
const posts = await getPosts()

const list = getListFromMap(categoryMap)

// 收集所有标签及其文章数
const tagCountMap = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCountMap.set(tag, (tagCountMap.get(tag) ?? 0) + 1)
  }
}
const tagList = Array.from(tagCountMap).sort((a, b) => b[1] - a[1])

function getListFromMap(map: typeof categoryMap) {
  return Array.from(map).map(([key, value]) => ({
    title: key,
    href: withBase(`/categories/${getPathFromCategory(key, themeConfig.site.categoryMap)}`),
    size: t('categories_count', value.length),
  }))
}
---

<LayoutDefault>
  <section class="categories-index">
    <h2 class="categories-index__title">{t('Categories')}</h2>
    <ul class="post-list">
      {
        list.map(({ title, href, size }) => (
          <li class="post-list__item">
            <a class="post-list__title" href={href}>{title}</a>
            <span class="post-list__meta">{size}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {tagList.length > 0 && (
    <section class="categories-index categories-index--tags">
      <h2 class="categories-index__title">{t('Tags')}</h2>
      <div class="tag-cloud">
        {tagList.map(([tag, count]) => (
          <a class="tag-cloud__item not-underline-hover" href={withBase(`/tags/${tag}`)}>
            <span class="tag-cloud__hash" aria-hidden="true">#</span>
            <span class="tag-cloud__label">{tag}</span>
            <span class="tag-cloud__count">{count}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</LayoutDefault>
