---
import { themeConfig } from '~/.config'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { formatDate, getCategories, getPathFromCategory, withBase } from '~/utils'

export async function getStaticPaths() {
  const categoryMap = await getCategories()
  return Array.from(categoryMap).map(([key, value]) => {
    const path = getPathFromCategory(key, themeConfig.site.categoryMap)
    return {
      params: { category: path },
      props: { posts: value, name: key },
    }
  })
}

const { posts, name } = Astro.props

function getListItems(posts: Post[]) {
  const result = posts.map((post) => ({
    title: post.data.title,
    href: withBase(`/posts/${post.id}/`),
    date: formatDate(post.data.pubDate),
  }))
  return result
}
---

<LayoutDefault>
  <section class="archive-index">
    <h2 class="archive-index__title">
      <span class="archive-index__prefix" aria-hidden="true">#</span>{name}
    </h2>
    <ul class="post-list">
      {
        getListItems(posts).map(({ title, href, date }) => (
          <li class="post-list__item">
            <a class="post-list__title" href={href}>{title}</a>
            <time class="post-list__date">{date}</time>
          </li>
        ))
      }
    </ul>
  </section>
</LayoutDefault>
