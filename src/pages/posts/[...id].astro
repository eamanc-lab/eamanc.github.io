---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import Comments from '~/components/Comments.astro'
import Hero from '~/components/Hero.astro'
import Pagination from '~/components/Pagination.astro'
import PostCategory from '~/components/PostCategory.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import LayoutPost from '~/layouts/LayoutPost.astro'
import { formatDate, getPosts, withBase } from '~/utils'
import { render } from 'astro:content'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post, idx) => {
    const prev = posts[idx - 1]
    const next = posts[idx + 1]
    return {
      params: { id: post.id },
      props: { entry: post, next, prev },
    }
  })
}) satisfies GetStaticPaths

// type Params = InferGetStaticParamsType<typeof getStaticPaths>
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const { translate: t } = Astro.locals

function getUrl(id: string) {
  return withBase(`/posts/${id}`)
}

// Hero 首字 — Array.from 正确处理 surrogate pair 中文(如"你好"→"你")
const titleChars = Array.from(entry.data.title)
const firstChar = titleChars[0] ?? '文'

const categories = entry.data.categories ?? []
const tags = entry.data.tags ?? []
const dateStr = formatDate(entry.data.modDate ?? entry.data.pubDate)
const dateLabel = entry.data.modDate ? t('updated_at') : t('posted_at')
---

<LayoutDefault>
  <SiteSeo slot="seo" title={entry.data.title} desc={entry.data.description} banner={entry.data.banner} />

  {/* Task 8 — 文章详情 hero:文章标题升 hero 字阶,bg-char 取首字
       PostMeta 不再在 prose 内部(LayoutPost 已删该引用),date/cats/tags 行作为
       hero 下方的 .post-detail__meta 独立呈现。 */}
  <Hero
    eyebrow={{ seal: '文', label: `Post · ${dateStr}` }}
    title={entry.data.title}
    sub={entry.data.description}
    bgChar={firstChar}
  />

  <div class="post-detail">
    <div class="post-detail__meta">
      <span class="post-detail__meta-label">{dateLabel}</span>
      <time class="post-detail__date">{dateStr}</time>
      {categories.length > 0 && (
        <span class="post-detail__cats">
          {categories.map((c: string) => <PostCategory category={c} />)}
        </span>
      )}
      {tags.length > 0 && (
        <span class="post-detail__tags">
          {tags.map((tag: string) => (
            <a class="post-tag not-underline-hover" href={withBase(`/tags/${tag}`)}>#{tag}</a>
          ))}
        </span>
      )}
    </div>

    <LayoutPost post={entry}>
      <Content />
    </LayoutPost>
  </div>

  <Pagination
    showLeft={Boolean(prev)}
    leftTitle={`${t('prev_post')}: ${prev?.data.title}`}
    leftUrl={getUrl(prev?.id)}
    showRight={Boolean(next)}
    rightTitle={`${t('next_post')}: ${next?.data.title}`}
    rightUrl={getUrl(next?.id)}
    showPageCount={false}
  />
  <!-- BUG 这里使用 client:visible 会导致构建失败。ref: https://github.com/withastro/astro/issues/7329 -->
  <Comments post={entry} />
</LayoutDefault>

<script>
  import '@github/clipboard-copy-element'

  document.addEventListener('clipboard-copy', (event) => {
    const target = event.target as HTMLElement
    const icon = target.querySelector('.icon') as HTMLElement
    icon.classList.replace('i-mdi-content-copy', 'i-mdi-check')
    setTimeout(() => {
      icon.classList.replace('i-mdi-check', 'i-mdi-content-copy')
    }, 1500)
  })

  const codeBlocks = Array.from(document.querySelectorAll('pre'))
  // Task 12:删 `text-white`(GitHub 暗主题遗留),让 icon 继承 .clipboard-copy 的 sumi
  // ink color(默认 --ink-mid,hover --ink)。i-mdi-* 是 iconify mask SVG,生效 currentColor。
  const icon = "<div class='i-mdi-content-copy icon'></div>"
  for (const codeBlock of codeBlocks) {
    const wrapper = document.createElement('div')
    wrapper.className = 'code-container'

    const copyButton = document.createElement('clipboard-copy')
    const code = codeBlock.querySelector('code')
    copyButton.value = code?.textContent ?? ''
    copyButton.className = 'clipboard-copy'
    copyButton.innerHTML = icon

    codeBlock.appendChild(copyButton)

    codeBlock.parentNode?.insertBefore(wrapper, codeBlock)
    wrapper.appendChild(codeBlock)
  }
</script>

<style is:global>
  /* ─── Task 12 ⑫.2 — .clipboard-copy sumi 化(配合 astro.config.ts ⑫.0 双 theme) ──
     原色 #30363d(GitHub 暗灰)与 sumi 宣纸冲突。改用 ink 的 6% color-mix 透明叠加,
     与 Task 8 .btn.ghost hover bg 同节奏。icon 默认 --ink-mid,hover --ink,亮/暗
     模式都自洽(--ink-mid/--ink 在 :root 与 html.dark 段均已定义,Task 3)。
     不加 filter:url(#ink-bleed-btn) —— 复制按钮是 UI 动作,毛边软化会削弱可点击
     边界感(Task 8 .btn.ghost 同策略未加 ink-bleed)。border-radius 保 0.25rem 与
     Task 5 article.prose pre 的 4px 同微圆收口节奏。 */
  .code-container {
    position: relative;
  }
  .clipboard-copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 0.25rem;
    color: var(--ink-mid);
    transition: background-color 200ms ease, color 200ms ease;
  }

  .clipboard-copy:hover {
    background-color: color-mix(in oklab, var(--ink) 6%, transparent);
    color: var(--ink);
  }

  /* 确保 .clipboard-copy 的 color(默认 --ink-mid / hover --ink)继承到 .icon,
     经 UnoCSS presetIcons 的 currentColor 链路驱动 mask-based SVG (i-mdi-*) 渲染。
     `text-white` 已在同段 commit 的 line 73 注入串中删除,本规则现在是 currentColor
     链路的显式锚定(防御后续 Uno 类回流时再次覆盖 color)。 */
  .clipboard-copy .icon {
    color: inherit;
  }
</style>
